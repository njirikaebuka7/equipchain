{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --parallel --filter @workspace/api --filter @workspace/web dev",
    "dev:all": "pnpm --parallel --filter @workspace/api --filter @workspace/web --filter @workspace/mockup-sandbox dev",
    "lint": "prettier --check .",
    "start": "node apps/api/dist/index.mjs",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:push": "pnpm --filter @workspace/db push",
    "db:push-force": "pnpm --filter @workspace/db push-force"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
