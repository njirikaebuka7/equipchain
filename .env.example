# =============================================================================
# EquipChain Global Ltd — Environment Variables Template
# Copy this file to '.env' and populate with your local values.
# =============================================================================

# Database Connection (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://username:password@host:port/database"

# Supabase API Details
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server Host & Ports
NODE_ENV="development" # development or production
PORT=5000              # Port that Express Backend API server runs on
FRONTEND_PORT=5173     # Port that Vite Frontend React dev server runs on
MOCKUP_PORT=5174       # Port that UI mockup-sandbox runs on
BASE_PATH="/"          # Base URL path (usually "/")

# Security Secrets
# A long, cryptographically secure random string used to sign session cookies
SESSION_SECRET="your-express-session-cookie-secret-key-change-this-in-production"

# Production (Vercel) — set to your Vercel deployment URL for CORS
# Example: https://equipchain.vercel.app
FRONTEND_URL=
